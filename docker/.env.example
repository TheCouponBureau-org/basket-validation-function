PORT=3000
TCB_ENDPOINT=https://api.try.thecouponbureau.org
TCB_ACCESS_KEY=YOUR_ACCESS_KEY
TCB_SECRET_KEY=YOUR_SECRET_KEY
# Optional. When set, callers must send this value in the x-api-key header.
# Leave blank to keep the API routes open.
SERVICE_API_KEY=

# Incremental MOF sync every four hours in the container timezone.
MOF_SYNC_CRON=0 */4 * * *
MOF_SYNC_ON_START=true
TZ=UTC
